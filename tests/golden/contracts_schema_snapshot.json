      "event_id": {
        "title": "Event Id",
        "type": "string"
      },
      "session_id": {
        "title": "Session Id",
        "type": "string"
      },
      "seq": {
        "title": "Seq",
        "type": "integer"
      },
      "type": {
        "title": "Type",
        "type": "string"
      },
      "action_id": {
        "title": "Action Id",
        "type": "string"
      },
      "fields": {
        "additionalProperties": {
          "$ref": "#/$defs/TaggedValue"
