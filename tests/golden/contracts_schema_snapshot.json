  "Event": {
    "$defs": {
      "Decision": {
        "description": "Final gateway / decision function outcome.",
        "enum": [
          "ALLOW",
          "DENY",
          "REVIEW"
        ],
        "title": "Decision",
        "type": "string"
      },
      "Provenance": {
        "description": "Attestation source for field values in state tracking.",
        "enum": [
          "GATEWAY",
          "REGISTRY",
          "TOOL_TYPED",
          "TOOL_FREETEXT",
          "AGENT_CLAIM"
